{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Anki: Build + Install + Run (AI Flashcards)",
      "type": "shell",
      "command": "uv run python scripts/dev.py all --addon ai_flashcards",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
